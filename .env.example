# Deployment values for this repository.
#
# Copy this file to .env and fill in your own values:
#
#   cp .env.example .env
#
# .env is gitignored and never committed. It is read by scripts/rebuild.sh,
# which exports the values and evaluates the flake with --impure, because a
# flake evaluation cannot see the environment on its own.
#
# The file is sourced by the shell, so it holds plain KEY=value lines.

# The base domain this machine serves. The public hostnames are derived from
# it: portainer.app.$PUBLIC_DOMAIN, app.$PUBLIC_DOMAIN, and so on.
PUBLIC_DOMAIN=example.com

# The contact address registered with the ACME certificate authority
# (Let's Encrypt). Used for expiry notices and abuse reports.
ACME_EMAIL=admin@example.com

# The public IPv4 address of this machine. Every hostname it serves needs a
# DNS A record pointing here. The configuration warns while this is still
# the placeholder.
PUBLIC_IP=203.0.113.10

# The flake output to build: the file name of the machine in hosts/ without
# the .nix extension. Read by scripts/rebuild.sh.
FLAKE_OUTPUT=nixos

# The directory holding this machine's secret files, relative to the
# repository root. The default is "secrets", i.e. <checkout>/secrets.
#
# The directory is gitignored, so its contents are never committed and never
# copied into the Nix store. scripts/init-secrets.sh creates it.
SECRETS_DIR=secrets
